# Copy this file to .env and fill in the values
# Discord bot token
DISCORD_TOKEN=your_discord_token_here

# Optional: restrict command sync to a single guild for fast iteration
# GUILD_ID=123456789012345678

# Optional: comma-separated user IDs who are considered owners
# BOT_OWNER_IDS=111111111111111111,222222222222222222

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Health/metrics server runs on 0.0.0.0:8080 by default

